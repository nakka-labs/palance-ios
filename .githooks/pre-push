#!/bin/sh
#
# Palance pre-push checks. Replaces the metered macOS GitHub Actions runner —
# the iOS build + unit tests run here, on your Mac, for free.
#
# Enable once per clone:   make hooks   (sets core.hooksPath to .githooks)
# Run the same checks manually:   make check
#
# Bypass:
#   SKIP_CHECKS=1 git push        skip everything
#   SKIP_APP_CHECK=1 git push     skip only the iOS build (e.g. no Xcode handy)

set -e

if [ -n "$SKIP_CHECKS" ]; then
  echo "pre-push: SKIP_CHECKS set — skipping all checks"
  exit 0
fi

repo=$(git rev-parse --show-toplevel)
cd "$repo"

# Determine the commit range being pushed, so a docs-only push stays instant.
# Empty range (new branch, or invoked by `make check`) => run every check.
range=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range=""
  else
    range="${remote_sha}..${local_sha}"
  fi
done

touches() {
  [ -z "$range" ] && return 0
  # Doc-only changes never trigger a build.
  git diff --name-only "$range" 2>/dev/null | grep -vE '(^|/)(README|.*\.(md|txt))$|(^|/)docs/' | grep -qE "$1"
}

log=$(mktemp -t palance-prepush)
step() {
  desc="$1"; shift
  printf 'pre-push: %s ... ' "$desc"
  if "$@" >"$log" 2>&1; then
    echo "ok"
  else
    echo "FAILED"
    echo "----------------------------------------------------------------" >&2
    tail -40 "$log" >&2
    echo "----------------------------------------------------------------" >&2
    echo "pre-push FAILED at: $desc" >&2
    rm -f "$log"
    exit 1
  fi
}

# --- PalanceKit — pure Swift, fast --------------------------------------------
if touches '^(PalanceKit/|test-fixtures/)'; then
  step "swift test --package-path PalanceKit" \
    swift test --package-path PalanceKit
fi

# --- Worker — Node, fast ----------------------------------------------------
if touches '^(worker/|test-fixtures/)'; then
  step "worker typecheck" sh -c 'npm --prefix worker run typecheck'
  step "worker test" sh -c 'npm --prefix worker test'
fi

# --- iOS app — build + PalanceTests (needs Xcode + a Simulator) -----------
if [ -n "$SKIP_APP_CHECK" ]; then
  echo "pre-push: SKIP_APP_CHECK set — skipping the iOS build"
elif touches '^(App/|PalanceKit/)'; then
  if ! command -v xcodegen >/dev/null 2>&1; then
    echo "pre-push FAILED: xcodegen not found. Install it (brew install xcodegen)" >&2
    echo "or push with SKIP_APP_CHECK=1 if you can't verify the iOS build here." >&2
    rm -f "$log"; exit 1
  fi
  sim=$(xcrun simctl list devices available 2>/dev/null \
        | grep -E 'iPhone' | grep -Eo '[0-9A-Fa-f-]{36}' | head -1)
  if [ -z "$sim" ]; then
    echo "pre-push FAILED: no iOS Simulator available (open Xcode once, or SKIP_APP_CHECK=1)" >&2
    rm -f "$log"; exit 1
  fi
  step "xcodegen generate" sh -c 'cd App && xcodegen generate'
  step "iOS build + PalanceTests" \
    xcodebuild test \
      -project App/Palance.xcodeproj -scheme Palance \
      -destination "id=$sim" \
      -derivedDataPath "$repo/App/.build-hook" \
      -quiet CODE_SIGNING_ALLOWED=NO
fi

# --- Cloud CI on main — warn, never block -----------------------------------
# The Linux CI once stayed red on main for six weeks unnoticed (`CHECKLIST.md`
# "Test framework rebuild" step 6). Surface the latest result of every
# workflow on main here, where someone is actually looking. Silent if `gh`
# isn't installed or signed in.
if command -v gh >/dev/null 2>&1; then
  failing=$(gh run list --branch main --status completed --limit 30 \
    --json workflowName,conclusion \
    --jq 'reduce .[] as $r ({}; if has($r.workflowName) then . else . + {($r.workflowName): $r.conclusion} end)
          | to_entries[] | select(.value == "failure") | .key' 2>/dev/null || true)
  if [ -n "$failing" ]; then
    echo "pre-push: WARNING — latest CI run on main is FAILING for:" >&2
    echo "$failing" | sed 's/^/pre-push:   - /' >&2
    echo "pre-push:   (not blocking this push — check: gh run list --branch main)" >&2
  fi
fi

rm -f "$log"
echo "pre-push: all checks passed"
